# ---------- LLM (อยู่ฝั่ง FastAPI เท่านั้น ไม่ถูกส่งเข้า sandbox) ----------
# รูปแบบ "provider:model" ตาม init_chat_model เช่น openai:gpt-5-mini, anthropic:claude-sonnet-4-6
MODEL=openai:gpt-5-mini
OPENAI_API_KEY=sk-...
# ถ้าใช้ endpoint ที่ compatible กับ OpenAI (LiteLLM, vLLM, Azure proxy ฯลฯ) ใส่ base url ตรงนี้
# OPENAI_BASE_URL=https://your-litellm-host/v1
# ANTHROPIC_API_KEY=...

# ---------- Sandbox ----------
SANDBOX_IMAGE=poc-deepagent-sandbox:latest
SANDBOX_NETWORK=none          # none = ตัด internet ; bridge = เปิด
SANDBOX_MEM=512m
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=256
SANDBOX_EXEC_TIMEOUT=60       # วินาทีต่อหนึ่งคำสั่ง
SANDBOX_MAX_OUTPUT_BYTES=50000
SANDBOX_IDLE_TTL=900          # วินาที ไม่ใช้เกินนี้ container ถูกลบ

# (เฉพาะแบบ uv run) ถ้า Docker Desktop ไม่มี /var/run/docker.sock ให้ตั้งเอง หรือปล่อยว่างให้ระบบหาให้
# ห้ามตั้งตอนใช้ docker compose — compose ตั้งให้ api ชี้ไปที่ socket-proxy เอง
# DOCKER_HOST=unix:///Users/<you>/.docker/run/docker.sock
